# Copy to .env.local and adjust. Never commit .env.local.
MONGODB_URI=mongodb://127.0.0.1:27017/foodiebites
MONGODB_DB=foodiebites

# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Local development. On Vercel use the production URL instead, e.g.
# https://foodie-bites-tau.vercel.app
BETTER_AUTH_URL=http://localhost:3000
